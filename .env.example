# ==============================================================================
# MarketWave - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Models & API Keys (Required for Intelligence & Synthesis)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for 18-topic structured sentiment analysis & chat)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Primary Gemini Model for Multi-Agent Orchestrator
AGENT_MODEL="gemini-2.5-flash"

# Hugging Face User Access Token (Required for Market Intelligence Briefing with Gemma)
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_huggingface_token_here"

# Gemma Inference Model ID on Hugging Face (e.g. google/gemma-2-9b-it, google/gemma-3-12b-it)
GEMMA_MODEL="google/gemma-2-9b-it"

# ------------------------------------------------------------------------------
# 2. Market News Discovery (Finnhub API)
# ------------------------------------------------------------------------------
# Finnhub Stock API Key (Primary source for real-time ticker company news)
# Get a free key at: https://finnhub.io/
FINHUB_API_KEY="your_finnhub_api_key_here"

# ------------------------------------------------------------------------------
# 3. Google Cloud Firestore Database Configuration
# ------------------------------------------------------------------------------
# Local Development Mode (Firestore Emulator) - Default setup
FIRESTORE_PROJECT_ID=marketwave-demo
FIRESTORE_EMULATOR_HOST=localhost:8080

# Production Cloud Mode (Real Google Cloud Firestore on GCP)
# Uncomment for Cloud Run / GCP deployment (and remove FIRESTORE_EMULATOR_HOST):
# FIRESTORE_PROJECT_ID=your-gcp-project-id

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
# Admin Key for triggering scoped news ingestion & pipeline maintenance endpoints
ADMIN_KEY="your_secure_admin_key_here"

# Google OAuth 2.0 Client ID for Web Sign-In (optional)
# Create credentials in GCP Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Maximum registered users limit for demo safety guardrail
MAX_TOTAL_USERS=14

# ------------------------------------------------------------------------------
# 5. Network & CORS (Allowed Frontend Origins)
# ------------------------------------------------------------------------------
# Comma-separated list of permitted web origins for CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 6. Real-Time Ingestion & Scheduler Timing
# ------------------------------------------------------------------------------
# News polling cycle interval in seconds (default: 60)
MARKET_NEWS_POLL_SECONDS=60

# Debounce window in seconds for generating fresh Market Intelligence briefings (default: 10)
GEMMA_BRIEFING_DEBOUNCE_SECONDS=10

# Ingestion timeout and retry configuration
NEWS_FETCH_TIMEOUT_SECONDS=10
NEWS_FETCH_MAX_RETRIES=3
TICKER_INGEST_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# 7. Payments (Razorpay Integration)
# ------------------------------------------------------------------------------
# Razorpay test keys (https://dashboard.razorpay.com/app/keys) — Never commit live keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_test_key_secret"
