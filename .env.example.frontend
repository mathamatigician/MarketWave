# MarketWave Frontend Vercel Environment Variables
# Configure these in your Vercel Project Settings > Environment Variables

# Backend API endpoint on Google Cloud Run (HTTPS)
VITE_API_URL=https://marketwave-backend-xxxxxx-uc.a.run.app

# Backend WebSocket endpoint on Google Cloud Run (WSS)
VITE_WS_URL=wss://marketwave-backend-xxxxxx-uc.a.run.app

# Google OAuth Client ID (optional)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Scheduled consistency refresh interval in milliseconds (default: 300000 = 5 minutes)
VITE_MARKET_DATA_REFRESH_INTERVAL_MS=300000

# Gemma briefing debounce timeout in seconds (default: 10)
VITE_GEMMA_BRIEFING_DEBOUNCE_SECONDS=10

# API HTTP request timeout in milliseconds (default: 10000)
VITE_API_REQUEST_TIMEOUT_MS=10000

# Feature flags
VITE_ENABLE_PRICING=false
VITE_ENABLE_FEEDBACK=false
